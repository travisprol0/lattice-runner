# Copy to .env and fill in. Never commit .env.
GITHUB_RUNNER_TOKEN=ghp_REPLACE_ME

# Optional — freeze the image (default: floating latest).
# GITHUB_RUNNER_IMAGE_TAG=latest
# GITHUB_RUNNER_IMAGE_TAG=2.338.2
# GITHUB_RUNNER_IMAGE_TAG=ubuntu-noble

# Optional — seconds to wait after stop during `bash up.sh --upgrade` (default 90).
# SESSION_WAIT=90
