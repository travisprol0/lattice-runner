# Copy to .env and fill in. Never commit .env.
GITHUB_RUNNER_TOKEN=ghp_REPLACE_ME

# Image OS must match what actions/setup-python supports (GitHub-hosted Ubuntu).
# Default in compose is ubuntu-noble (24.04). Do NOT use bare `latest` (resolute) —
# setup-python Pythons then fail with "ssl module in Python is not available".
# GITHUB_RUNNER_IMAGE_TAG=ubuntu-noble
# GITHUB_RUNNER_IMAGE_TAG=ubuntu-jammy
# GITHUB_RUNNER_IMAGE_TAG=2.338.2-ubuntu-noble

# Optional — seconds to wait after stop during `bash up.sh --upgrade` (default 90).
# SESSION_WAIT=90
